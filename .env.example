# Copy to .env:  cp .env.example .env
# Every key is read by app/config.py. Defaults in that file match these values.

# --- provider ---------------------------------------------------------------
# One adapter per dialect (anthropic_p.py, openai_p.py), each driving its
# vendor's real SDK. PROVIDER names the dialect, not a Python class; the base
# URL alone chooses the transport. Pointed at the local mock (the default) you exercise the
# genuine SDK -- its stream parsing, its typed errors, its retry behaviour --
# with no API key and no network.
PROVIDER=anthropic
PROVIDER_BASE_URL=http://localhost:8081
ANTHROPIC_API_KEY=not-a-real-key
OPENAI_API_KEY=not-a-real-key

# Real, billable traffic is refused unless you opt in. Clearing
# PROVIDER_BASE_URL (or pointing it at api.anthropic.com) requires
# ALLOW_REAL_API=true and a real key. Nothing in the workshop needs this.
ALLOW_REAL_API=false
MODEL=claude-haiku-4-5
TEMPERATURE=0.0
MAX_TOKENS=1024

# --- reliability ------------------------------------------------------------
MAX_RETRIES=3
REQUEST_TIMEOUT_S=8.0
FIRST_TOKEN_TIMEOUT_S=1.5
MAX_CONCURRENCY=4
SPEND_CEILING_USD=1.0
# At most RATE_LIMIT_REQUESTS upstream calls in any RATE_LIMIT_WINDOW_S seconds.
# 0 disables it. Set it to your tier's requests-per-minute, minus some headroom.
RATE_LIMIT_REQUESTS=0
RATE_LIMIT_WINDOW_S=60

# --- mock fault injection ---------------------------------------------------
# FAULT_RATE 0-1. FAULT_MODE: all | rate_limit | timeout | truncated_stream | bad_content
# (or refusal: permanent, Anthropic dialect only, never part of `all`)
FAULT_RATE=0.0
FAULT_MODE=all
SEED=1337

# The mock also accepts per-request `x-mock-fault-mode` / `x-mock-fault-rate`
# headers, which override the two settings above for a single call.
#
#   These headers are a MOCK-ONLY extension. They are NOT part of the Anthropic
#   API, the real API ignores them, and nothing in app/ may send them.
#
# They exist for tests that need one specific fault without restarting the mock.
# The graded run sets MOCK_ALLOW_HEADER_OVERRIDE=false, so you cannot turn a
# failing reliability test green by adding a header instead of fixing the code.
# When refused, the mock counts it in /stats (`header_overrides_refused`) and
# answers with `x-mock-header-override: refused`.
MOCK_ALLOW_HEADER_OVERRIDE=true

# How long the mock takes to answer, in seconds. 0 keeps the tests fast; set
# it (e.g. 0.5) when you run `make mock` by hand and want peak_concurrency in
# /stats to show real overlap.
MOCK_LATENCY_S=0

# The mock's own rate limit, enforced the way a provider does: past
# MOCK_RATE_LIMIT_REQUESTS calls in any MOCK_RATE_LIMIT_WINDOW_S it answers 429
# with Retry-After and counts the call as `throttled` in /stats. 0 disables it.
MOCK_RATE_LIMIT_REQUESTS=0
MOCK_RATE_LIMIT_WINDOW_S=60

# --- infrastructure ---------------------------------------------------------
# USE_FAKEREDIS=true is the no-Docker path; compose sets it false.
REDIS_URL=redis://localhost:6379/0
USE_FAKEREDIS=true
